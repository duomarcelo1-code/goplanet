# Copiar este archivo como .env y completar con las credenciales reales.
# El .env NO se sube al repositorio (esta ignorado en .gitignore).

# === SMTP (envio de mails) ===
# Credenciales de Mailtrap: https://mailtrap.io/inboxes -> SMTP Settings
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=

# === Base de datos MySQL ===
MYSQL_HOST=localhost
MYSQL_DB_NAME=programacion
MYSQL_USER=root
MYSQL_PASSWORD=
