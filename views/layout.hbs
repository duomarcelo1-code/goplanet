<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- ================================================= -->
<!-- ==================== POPUP ====================== -->
<!-- ================================================= -->

{{#if message}}
    <div id="popup-data"
         data-msg="{{message}}"
         data-error="{{#if error}}1{{/if}}"
         style="display:none"></div>
{{/if}}

<script>
    (function(){
        // 1) Si el servidor mando un mensaje, lo guardamos y limpiamos la URL.
        //    Guardamos hasta cuando debe mostrarse (ahora + 4 seg) para que
        //    el popup sobreviva aunque la pagina se recargue.
        var data = document.getElementById('popup-data');
        if(data){
            sessionStorage.setItem('popupMsg', data.getAttribute('data-msg'));
            sessionStorage.setItem('popupError', data.getAttribute('data-error') || '');
            sessionStorage.setItem('popupUntil', String(Date.now() + 4000));
            if(window.history.replaceState){
                window.history.replaceState({}, document.title, window.location.pathname);
            }
        }

        // 2) Si hay un mensaje pendiente y todavia no expiro, lo mostramos.
        var msg = sessionStorage.getItem('popupMsg');
        var until = parseInt(sessionStorage.getItem('popupUntil') || '0', 10);
        var restante = until - Date.now();

        if(!msg || restante <= 0){
            sessionStorage.removeItem('popupMsg');
            sessionStorage.removeItem('popupError');
            sessionStorage.removeItem('popupUntil');
            return;
        }

        var isError = sessionStorage.getItem('popupError') === '1';

        var p = document.createElement('div');
        p.className = 'popup' + (isError ? ' popup-error' : '');
        p.textContent = msg;
        document.body.appendChild(p);

        setTimeout(function(){
            p.classList.add('hide');
            setTimeout(function(){ p.remove(); }, 400);
            sessionStorage.removeItem('popupMsg');
            sessionStorage.removeItem('popupError');
            sessionStorage.removeItem('popupUntil');
        }, restante);
    })();
</script>

</body>

