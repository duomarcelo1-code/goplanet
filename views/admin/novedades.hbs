<!-- ================================================= -->
<!-- ================= PANEL ADMIN =================== -->
<!-- ================================================= -->

<div class="admin-container">

    <div class="admin-panel">

        <!-- ========================= -->
        <!-- ENCABEZADO -->
        <!-- ========================= -->

        <div class="admin-header">

            <div>

                <h3 class="admin-titulo">

                    <i class="bi bi-send-fill"></i>

                    Bienvenido, {{usuario}}

                </h3>

                <p class="admin-subtitulo">

                    Administrá las
                    <span>Promociones Especiales</span>
                    que se muestran en la web.

                </p>

            </div>

            <a href="/admin/login/logout"
               class="btn-salir">

                <i class="bi bi-box-arrow-right"></i>

                Cerrar sesión

            </a>

        </div>

        <!-- ========================= -->
        <!-- CUERPO DEL PANEL -->
        <!-- ========================= -->

        <div class="admin-layout">

            <!-- ================================================= -->
            <!-- ==================== FORM ======================= -->
            <!-- ================================================= -->

            <div class="admin-form-card {{#if editar}}admin-form-editando{{/if}}">

                <h4 class="admin-form-titulo">

                    {{#if editar}}

                        <i class="bi bi-pencil-square"></i>

                        Editar promoción

                    {{else}}

                        <i class="bi bi-plus-circle"></i>

                        Nueva promoción

                    {{/if}}

                </h4>

                <form action="{{#if editar}}/admin/novedades/editar/{{editar.id}}{{else}}/admin/novedades/agregar{{/if}}"
                      method="post">

                    <div class="admin-campo">

                        <label for="titulo">Título</label>

                        <input type="text"
                               id="titulo"
                               name="titulo"
                               value="{{editar.titulo}}"
                               placeholder="Ej: ✈️ 2x1 en vuelos a Brasil"
                               required>

                    </div>

                    <div class="admin-campo">

                        <label for="cuerpo">Cuerpo</label>

                        <textarea id="cuerpo"
                                  name="cuerpo"
                                  rows="6"
                                  placeholder="Ej: Promo exclusiva para viajar en pareja."
                                  required>{{editar.cuerpo}}</textarea>

                    </div>

                    <div class="admin-form-botones">

                        <button type="submit"
                                class="btn-guardar">

                            <i class="bi bi-check-lg"></i>

                            {{#if editar}}Guardar cambios{{else}}Agregar promoción{{/if}}

                        </button>

                        {{#if editar}}

                            <a href="/admin/novedades"
                               class="btn-cancelar">

                                Cancelar

                            </a>

                        {{/if}}

                    </div>

                </form>

            </div>

            <!-- ================================================= -->
            <!-- ==================== LISTA ====================== -->
            <!-- ================================================= -->

            <div class="admin-lista">

                <!-- ========================= -->
                <!-- BUSCADOR -->
                <!-- ========================= -->

                <div class="admin-buscador">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           id="buscador"
                           placeholder="Buscar promoción por título...">

                </div>

                <!-- ========================= -->
                <!-- TABLA -->
                <!-- ========================= -->

                <div class="admin-tabla-wrapper">

                    <table class="admin-tabla">

                        <thead>

                            <tr>
                                <th>ID</th>
                                <th>Título</th>
                                <th>Cuerpo</th>
                                <th class="text-end">Acciones</th>
                            </tr>

                        </thead>

                        <tbody id="tabla-promociones">

                            {{#each promociones}}

                                <tr>

                                    <td class="admin-celda-id">{{this.id}}</td>

                                    <td class="admin-celda-titulo">{{this.titulo}}</td>

                                    <td class="admin-celda-cuerpo">{{this.cuerpo}}</td>

                                    <td class="text-end admin-celda-acciones">

                                        <a href="/admin/novedades/editar/{{this.id}}"
                                           class="btn-accion btn-editar"
                                           title="Editar">

                                            <i class="bi bi-pencil-fill"></i>

                                        </a>

                                        <form action="/admin/novedades/eliminar/{{this.id}}"
                                              method="post"
                                              onsubmit="return confirm('¿Seguro que querés eliminar la promoción &quot;{{this.titulo}}&quot;? Esta acción no se puede deshacer.');">

                                            <button type="submit"
                                                    class="btn-accion btn-borrar"
                                                    title="Eliminar">

                                                <i class="bi bi-trash3-fill"></i>

                                            </button>

                                        </form>

                                    </td>

                                </tr>

                            {{/each}}

                        </tbody>

                    </table>

                    <!-- ========================= -->
                    <!-- ESTADO VACIO -->
                    <!-- ========================= -->

                    {{#unless promociones}}

                        <div class="admin-vacio">

                            <i class="bi bi-inbox"></i>

                            <h5>Todavía no hay promociones</h5>

                            <p>Cargá la primera con el formulario de la izquierda.</p>

                        </div>

                    {{/unless}}

                </div>

            </div>

        </div>

    </div>

</div>

<!-- ================================================= -->
<!-- ==================== SCRIPT ===================== -->
<!-- ================================================= -->

<script>

    // Buscador: filtra las filas de la tabla por titulo.

    var buscador = document.getElementById('buscador');

    if(buscador){

        buscador.addEventListener('keyup', function(){

            var texto = buscador.value.toLowerCase();
            var filas = document.querySelectorAll('#tabla-promociones tr');

            filas.forEach(function(fila){

                var titulo = fila.querySelector('.admin-celda-titulo');

                if(!titulo) return;

                var coincide = titulo.textContent.toLowerCase().indexOf(texto) !== -1;

                fila.style.display = coincide ? '' : 'none';

            });

        });

    }

</script>
