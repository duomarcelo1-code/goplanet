<footer id="empresa">

    <div class="footer-contenido">

        <!-- IZQUIERDA -->

        <div class="footer-columna">

            <h2 class="footer-logo">

                ✈️ GoPlanet

            </h2>

            <p class="footer-texto">

                Viajá con nosotros a los mejores destinos del mundo.
                Descubrí promociones exclusivas, hoteles premium
                y experiencias inolvidables para tus vacaciones.

            </p>

            <div class="footer-redes">

                <a href="#">📸 Instagram</a>
                <a href="#">📘 Facebook</a>
                <a href="#">▶️ YouTube</a>

            </div>

        </div>

        <!-- CENTRO -->

        <div class="footer-columna footer-centro">

            <h3>Nuestra sede central</h3>

            <p>📍 Av. Corrientes 1450, Buenos Aires</p>

            <iframe
                src="https://www.google.com/maps?q=Av.+Corrientes+1450+Buenos+Aires&output=embed"
                allowfullscreen=""
                loading="lazy">
            </iframe>

        </div>

        <!-- DERECHA -->

        <div class="footer-columna">

            <div class="footer-formulario">

                <h3>Te llamamos</h3>

                <p>Dejanos tus datos y un asesor se comunica con vos.</p>

                <form action="/"
                      method="post">

                    <input type="name" placeholder="Nombre" name="name">

                    <input type="tel" placeholder="Teléfono" name="tel">

                    <input type="email" placeholder="Email" name="email">

                    <textarea type="text" placeholder="¿Qué destino te interesa?" name="text"></textarea>

                    <button type="submit">ENVIAR</button>
                
                </form>

            </div>

        </div>

    </div>