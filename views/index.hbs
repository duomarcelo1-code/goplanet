            </div>

        </div>

        <!-- ITEM 3 -->

        <div class="carousel-item">

            <img src="https://media.es.wired.com/photos/63e50509b3a7b733b95d448e/16:9/w_2560%2Cc_limit/Sci-amazon-1322470077.jpg"
                 class="d-block w-100"
                 alt="Amazonas">

            <div class="carousel-caption d-none d-md-block fondo-texto">

                <h2>

                    Ecuador

                </h2>

