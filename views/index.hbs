<!-- ================= PROMOCIONES =================== -->
<!-- ================================================= -->

<section id="promociones">

    <div class="promociones-titulo">

        Promociones Especiales

    </div>

    <div class="promociones-texto">

        Aprovechá nuestras ofertas exclusivas.

    </div>

    <div class="accordion accordion-flush"
         id="accordionPromos">

        <!-- ITEMS CARGADOS DESDE EL PANEL DE ADMIN -->

        {{#each promociones}}

            <div class="accordion-item">

                <h2 class="accordion-header">

                    <button class="accordion-button collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#promo{{this.id}}">

                        {{this.titulo}}

                    </button>

                </h2>

                <div id="promo{{this.id}}"
                     class="accordion-collapse collapse"
                     data-bs-parent="#accordionPromos">

                    <div class="accordion-body">

                        {{this.cuerpo}}

                    </div>

                </div>

            </div>

        {{/each}}

    </div>

</section>

